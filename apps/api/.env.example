ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================================
# Postgres (AWS Mumbai RDS in production; local Docker for dev).
# IMPORTANT: connect as noticedesk_app (non-superuser) so RLS is enforced.
# The superuser `noticedesk` is for migrations + schema tests only.
# ============================================================================
DATABASE_URL=postgresql+asyncpg://noticedesk_app:noticedesk_app@localhost:5432/noticedesk_dev

# ============================================================================
# Auth: 'clerk' or 'dev'. 'dev' is rejected outside ENVIRONMENT=development.
# Production requires AUTH_PROVIDER=clerk plus a one-time code change in
# app/core/auth.py (_verify_clerk currently raises NotImplementedError).
# ============================================================================
AUTH_PROVIDER=dev
CLERK_JWKS_URL=
CLERK_ISSUER=

# Sentry (leave blank to disable).
SENTRY_DSN=

# CORS origins for the Next.js frontend.
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# Storage — 'local' for dev/CI; 's3' for staging/prod.
# DPDP residency forces ap-south-1 for the bucket.
# ============================================================================
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/noticedesk-storage
AWS_REGION=ap-south-1
S3_DOCUMENTS_BUCKET=
MAX_UPLOAD_BYTES=52428800

# ============================================================================
# OCR — primary + optional fallback. Switching is config-only.
#   stub                : returns hash-based placeholder text (dev / CI)
#   google_doc_ai       : Google Cloud Document AI (production primary)
#   azure_doc_intel     : Azure Document Intelligence (production fallback)
# Install the SDK for whichever you pick:
#   pip install google-cloud-documentai
#   pip install azure-ai-documentintelligence azure-core
# ============================================================================
OCR_PROVIDER_PRIMARY=stub
OCR_PROVIDER_FALLBACK=

# Google Document AI — create a Form Parser or Custom Extractor processor
# in ap-south-1, then paste its IDs here. Auth is via the GOOGLE_APPLICATION_CREDENTIALS
# env var pointing at a service-account JSON file with documentai.processors.processDocument
# permission scoped to that processor.
GOOGLE_DOC_AI_PROJECT_ID=
GOOGLE_DOC_AI_LOCATION=
GOOGLE_DOC_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Document Intelligence — used only if OCR_PROVIDER_FALLBACK=azure_doc_intel.
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_API_KEY=

# ============================================================================
# Workflow backend — 'inline' (dev) blocks the request thread; 'temporal'
# submits to a cluster so partners don't wait 60s on the Generate Draft
# request.
# ============================================================================
WORKFLOW_BACKEND=inline
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=noticedesk-ocr

# ============================================================================
# Email inbound — SES routes notices+<firm-slug>@<domain> to a webhook.
# ============================================================================
EMAIL_INBOUND_WEBHOOK_SECRET=
EMAIL_INBOUND_DOMAIN=noticedesk.in

# ============================================================================
# LLM providers — 'stub' / 'anthropic' / 'openai'. Switching is config-only.
# Install the SDK extras for the provider you pick:
#   pip install -e ".[anthropic]"      # or [openai]
# ============================================================================
LLM_PROVIDER_PRIMARY=stub
LLM_PROVIDER_SECONDARY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

DOCUMENT_PARSING_PROMPT_VERSION=v1
DOCUMENT_PARSING_MAX_TOKENS=4096
DOCUMENT_PARSING_TEMPERATURE=0.0

# How many characters of the notice's OCR text get fed into the drafting
# prompt. 20K handles up to ~15-page notices comfortably. Bump higher for
# multi-PDF SCNs / appeal-stage compilations; each character is roughly
# 0.25 input tokens so 60000 ≈ 15K tokens per draft.
DRAFTING_OCR_EXCERPT_CHARS=20000

# ============================================================================
# Citation verification — 'stub' / 'indiankanoon'. Tier 2 (Taxmann/SCC) and
# Tier 3 (firm private library) are Phase 2/3.
# ============================================================================
CITATION_PROVIDER=stub
INDIANKANOON_API_TOKEN=

# ============================================================================
# Demo-mode escape hatch (do NOT set in production).
# When set, the LLM stub returns the named canned response for ANY parsing
# prompt that doesn't match a specific filename. Lets a partner drop any PDF
# during a demo without renaming it.
#   acme_mh_asmt10   → Acme Maharashtra ASMT-10 (clean route)
#   drc01a_anomaly   → Sunrise Papers DRC-01A (anomaly: client_not_found)
# ============================================================================
STUB_DEFAULT_CANNED=
