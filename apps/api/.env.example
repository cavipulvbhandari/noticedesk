ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres (AWS Mumbai RDS in production; local Docker for dev).
DATABASE_URL=postgresql+asyncpg://noticedesk:noticedesk@localhost:5432/noticedesk_dev

# Auth: 'clerk' or 'dev'. 'dev' is rejected outside ENVIRONMENT=development.
AUTH_PROVIDER=dev
CLERK_JWKS_URL=
CLERK_ISSUER=

# Sentry (leave blank to disable).
SENTRY_DSN=

# CORS origins for the Next.js frontend.
ALLOWED_ORIGINS=http://localhost:3000

# ---- Sprint 2: storage ------------------------------------------------------
# 'local' for dev / CI; 's3' for staging / prod (DPDP residency forces ap-south-1).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/noticedesk-storage
AWS_REGION=ap-south-1
S3_DOCUMENTS_BUCKET=
MAX_UPLOAD_BYTES=52428800

# ---- Sprint 2: OCR ----------------------------------------------------------
# Switching primary from one vendor to the other is a config-only change.
OCR_PROVIDER_PRIMARY=stub
OCR_PROVIDER_FALLBACK=

GOOGLE_DOC_AI_PROJECT_ID=
GOOGLE_DOC_AI_LOCATION=
GOOGLE_DOC_AI_PROCESSOR_ID=

AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_API_KEY=

# ---- Sprint 2: workflow backend --------------------------------------------
# 'inline' runs the OCR pipeline in-process (dev / CI). 'temporal' submits
# to a Temporal cluster.
WORKFLOW_BACKEND=inline
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=noticedesk-ocr

# ---- Sprint 2: email inbound -----------------------------------------------
# Shared secret for the SES → webhook hop. Required in production.
EMAIL_INBOUND_WEBHOOK_SECRET=
EMAIL_INBOUND_DOMAIN=noticedesk.in
