ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres (AWS Mumbai RDS in production; local Docker for dev).
DATABASE_URL=postgresql+asyncpg://noticedesk:noticedesk@localhost:5432/noticedesk_dev

# Auth: 'clerk' or 'dev'. 'dev' is rejected outside ENVIRONMENT=development.
AUTH_PROVIDER=dev
CLERK_JWKS_URL=
CLERK_ISSUER=

# Sentry (leave blank to disable).
SENTRY_DSN=

# CORS origins for the Next.js frontend.
ALLOWED_ORIGINS=http://localhost:3000
